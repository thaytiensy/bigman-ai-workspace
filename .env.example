# Cấu hình Tên miền & Deployment
NODE_ENV=production
NEXT_PUBLIC_SITE_URL=https://bigman-ai-workspace.vercel.app

# Cơ sở dữ liệu PostgreSQL / Supabase (tùy chọn — app chạy fallback an toàn nếu chưa cấu hình)
# Hỗ trợ Supabase Direct & PgBouncer Pooling (Port 6543 cho Vercel Serverless)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Khóa Mã Hóa BYOK (AES-256-GCM) — chuỗi Hex 64 ký tự (32 bytes)
# Sinh bằng: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BYOK_ENCRYPTION_KEY=

# Cổng Thanh toán VietQR & Webhook SePay (CHỈ đọc từ biến môi trường)
# Nếu để trống các biến NEXT_PUBLIC_VIETQR_*, giao diện sẽ hiển thị hướng dẫn
# liên hệ Zalo Admin 0353205414 hoặc Email thaytiensy@gmail.com để nhận QR kích hoạt.
NEXT_PUBLIC_VIETQR_BANK_BIN=
NEXT_PUBLIC_VIETQR_BANK_NAME=
NEXT_PUBLIC_VIETQR_ACCOUNT_NO=
NEXT_PUBLIC_VIETQR_ACCOUNT_NAME=
NEXT_PUBLIC_VIETQR_TEMPLATE=compact
SEPAY_WEBHOOK_SECRET=

# API Key AI Models (tùy chọn cho gói All-in-One Credits hoặc Platform Fallback)
# Người dùng cũng có thể tự nhập BYOK Key trực tiếp trên giao diện /workspace.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
